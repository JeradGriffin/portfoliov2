<html lang="en" data-theme="ink" data-accent="forest" data-layout="spine" data-hero="block">
  <head>
    <meta charset="utf-8" />
    <title @text="renderTitle(seo_title || title)"></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="view-transition" content="same-origin" />
    <meta name="generator" :content="eleventy.generator" />
    <meta property="og:title" :content="renderTitle(seo_title || title)" />
    <meta name="description" :content="seo_description ?? ''" property="og:description" />
    <meta property="og:image" :content="renderSocialImage(socialImage)" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#14130f" />
    <script webc:keep>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" webc:keep />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin webc:keep />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300..800&family=JetBrains+Mono:wght@300..600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&family=Bricolage+Grotesque:opsz,wght@12..96,300..800&display=swap" webc:keep />
    <link rel="stylesheet" :href="'/assets/atlas/atlas-' + atlasCss + '.css'" webc:keep />
    <link rel="stylesheet" :href="getBundleFileUrl('css')" webc:keep webc:if="getBundleFileUrl('css')" id="compiled-styles" />
  </head>
  <body>
    <a href="#content" class="reader-only skip-link">Jump to content</a>
    <div class="page">
      <div class="spread" @raw="content"></div>
    </div>
    <script src="/assets/atlas/atlas.js" webc:keep defer></script>
    <script :src="getBundleFileUrl('js')" webc:keep webc:if="getBundleFileUrl('js')" id="compiled-scripts" type="module" async></script>
  </body>
</html>
